node[prop("prop_lamp_type")="led"]::light_1 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_2 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_3 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_4 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_5 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_6 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_7 { icon-image: "icons/electric_led.svg" }
node[prop("prop_lamp_type")="led"]::light_8 { icon-image: "icons/electric_led.svg" }

node[prop("prop_lamp_type")!="led"]::light_1 { icon-image: "icons/electric.svg" }
node[prop("prop_lamp_type")!="led"]::light_2 { icon-image: "icons/electric.svg" }
