meta {
    title: "Street lamps";
    description: "Improves the visibility of highway=street_lamp objects.";
    author: "NieWnen";
    link: "https://github.com/praszuk/josm-street-lamps-style";
    version: "1.3_2025-10-19";
}

setting::base_circle_glow_size {
    type: double;
    label: tr("Base circle glow size");
    default: 40;
}

setting::base_circle_glow_opacity {
    type: double;
    label: tr("Base circle glow opacity (0.0-1.0)");
    default: 0.5;
}

setting::light_point_icon_size {
    type: double;
    label: tr("Light point icon size – width and height.");
    default: 40;
}

setting::light_point_icon_opacity {
    type: double;
    label: tr("Light point icon opacity (0.0-1.0)");
    default: 0.9;
}

setting::light_point_icon_radius {
    type: double;
    label: tr("Light point icon position from center (radius)");
    default: 15;
}

node[highway=street_lamp]::*{ prop_lamp_type: "electric"; prop_symbol_fill_color: "#ffbb44"; }
node[lamp_type=LED]::*{ prop_lamp_type: "led"; prop_symbol_fill_color: "#faf9f0"; }
node[lamp_type=led]::*{ prop_lamp_type: "led"; prop_symbol_fill_color: "#faf9f0"; }

/* Base glow */
node[highway=street_lamp]::lighting_glows {
    object-z-index: -1.0;
    symbol-shape: circle;
    symbol-size: setting(base_circle_glow_size);
    symbol-fill-opacity: setting(base_circle_glow_opacity);
    symbol-fill-color: prop(prop_symbol_fill_color);
}

/* Light points with light:count/light:direction tags */

/*
Each lamp point contains invisible text, because lamp points tend to glitch slightly.
For example, when the direction value changes, the lamp point start to jump when selecting object or zooming the view.
The "text" label forces JOSM to re-render on each degree change.

I suppose that JOSM caches certain attribute values, such as "text", but not "icon-offset-*",  and it listens for any changes in those cache attributes to trigger a re-render.
*/

/* --- Light point 1 --- */
node[highway=street_lamp][light:count>1]::light_1 {
    direction_list: split(";", tag("light:direction"));
    direction_len: length(prop(direction_list));
    
    default_degree: 0;
    degree: cond(prop(direction_len) > 0, get(prop(direction_list), 0), prop(default_degree));
    x: round(sin(degree_to_radians(prop(degree))) * setting(light_point_icon_radius));
    y: round(-cos(degree_to_radians(prop(degree))) * setting(light_point_icon_radius));
    text: concat(prop(x), ", ", prop(y));
    text-opacity: 0.0;
    
    icon-width: setting(light_point_icon_size);
    icon-height: setting(light_point_icon_size);
    icon-opacity: setting(light_point_icon_opacity);
    icon-offset-x: prop(x);
    icon-offset-y: prop(y);
}

/* --- Light point 2 --- */
node[highway=street_lamp][light:count>1]::light_2 {
    direction_list: split(";", tag("light:direction"));
    direction_len: length(prop(direction_list));
    
    default_degree: 360/tag("light:count");
    degree: cond(prop(direction_len) > 1, get(prop(direction_list), 1), prop(default_degree));
    x: round(sin(degree_to_radians(prop(degree))) * setting(light_point_icon_radius));
    y: round(-cos(degree_to_radians(prop(degree))) * setting(light_point_icon_radius));
    text: concat(prop(x), ", ", prop(y));
    text-opacity: 0.0;
    
    icon-width: setting(light_point_icon_size);
    icon-height: setting(light_point_icon_size);
    icon-opacity: setting(light_point_icon_opacity);
    icon-offset-x: prop(x);
    icon-offset-y: prop(y);
}

